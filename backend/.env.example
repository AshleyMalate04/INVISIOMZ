# InvisioMZ — variáveis de ambiente do backend. Copie para `.env` e ajuste. NUNCA faça commit do `.env`.
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO

# Modo convidado (ocultar/extrair sem conta). Por defeito DESLIGADO: é preciso iniciar sessão.
# Sem Supabase configurado e sem convidados, ninguém consegue usar a aplicação (ponha true só para desenvolvimento sem Supabase).
ALLOW_GUEST=false

# CORS: origens do frontend, separadas por vírgulas (em produção, sem "*")
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase (valores de `npx supabase status -o env`). Deixe vazio para correr só em modo convidado.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=coloque-aqui-a-anon-key
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui-a-service-role-key   # só no backend, nunca no frontend
SUPABASE_JWT_SECRET=coloque-aqui-o-jwt-secret               # HS256; se vazio usa JWKS (ES256/RS256)

# Sal para o hash dos IP no audit_log (obrigatório em produção). Gere com: python -c "import secrets;print(secrets.token_hex(32))"
IP_HASH_SALT=

# Limites (valores por defeito)
MAX_IMAGE_BYTES=20971520
MAX_IMAGE_PIXELS=12000000
MAX_FILES=20
MAX_FILE_BYTES=10485760
MAX_TOTAL_BYTES=26214400
MAX_REQUEST_BYTES=62914560
PASSWORD_MIN_LENGTH=10

# Operações pesadas em simultâneo (cada imagem de 12 MP usa ~1 GB de RAM)
MAX_CONCURRENT_JOBS=2

# Scrypt (N = 2^SCRYPT_LOG2N). Mínimo 14; os parâmetros ficam gravados no cabeçalho de cada imagem.
SCRYPT_LOG2N=15
SCRYPT_R=8
SCRYPT_P=1

# Rate limiting (pedidos por minuto e por IP) e backoff de senhas falhadas
RATE_LIMIT_ENABLED=true
RATE_HIDE_PER_MIN=20
RATE_EXTRACT_PER_MIN=10
EXTRACT_FAIL_THRESHOLD=5
# Atrás de um proxy inverso (nginx, Caddy…) ponha true para usar o IP de X-Forwarded-For; senão todos partilham o IP do proxy
TRUST_PROXY_HEADERS=false
# Quantos proxies de confiança há à frente da aplicação (1 = só o balanceador da plataforma)
PROXY_HOPS=1

# Retenção dos PNG guardados no histórico
RECORD_TTL_DAYS=7
SIGNED_URL_TTL_S=300
